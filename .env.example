# Copiar como .env junto a toolkit. No ejecutar con source.
# Valores literales: sin $VARIABLE, sustitución de comandos ni comentarios al final.
# Se admiten comillas envolventes para rutas con espacios. No se expanden variables.
# Usa rutas absolutas para ejecutables; las carpetas relativas parten del toolkit.
# Vacío conserva el valor por defecto / la búsqueda automática.
PYTHON_BIN=
BLENDER_BIN=
TOOLKIT_MODELOS_DIR=
TOOLKIT_OUTPUT_DIR=

# Ejemplos (sustituir las líneas vacías de arriba):
# PYTHON_BIN=/usr/bin/python3
# BLENDER_BIN=/home/usuario/soft/blender-5.2.3-linux-x64/blender
# TOOLKIT_MODELOS_DIR=/home/usuario/CAD/modelos
# TOOLKIT_OUTPUT_DIR=/home/usuario/CAD/resultados
# Sin TOOLKIT_OUTPUT_DIR, se usan modelos/<proyecto>/1_blender y 2_export.
# No se crean históricos; se sobrescriben los resultados de la etapa.
